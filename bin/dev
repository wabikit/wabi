#!/usr/bin/env bash
set -euo pipefail

if ! command -v overmind &> /dev/null && ! command -v foreman &> /dev/null; then
  echo "Install overmind (brew install overmind) or foreman (gem install foreman) to run bin/dev"
  echo "Or run the three processes manually:"
  echo "  Terminal 1: cd registry && mise exec -- bundle exec ./bin/build  # then fswatch loop"
  echo "  Terminal 2: cd docs && mise exec -- bin/rails tailwindcss:watch"
  echo "  Terminal 3: cd docs && mise exec -- bin/rails server -p 3000"
  exit 1
fi

if command -v overmind &> /dev/null; then
  overmind start -f Procfile.dev
else
  foreman start -f Procfile.dev
fi
