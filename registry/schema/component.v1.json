{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Wabi component v1",
  "type": "object",
  "required": ["name", "version", "files"],
  "properties": {
    "name":    { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+" },
    "type":    { "type": "string" },
    "description": { "type": "string" },
    "registry_dependencies": { "type": "array", "items": { "type": "string" } },
    "ruby_dependencies":     { "type": "array" },
    "js_dependencies":       { "type": "object" },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "type", "content"],
        "properties": {
          "path":    { "type": "string" },
          "type":    { "type": "string" },
          "content": { "type": "string" }
        }
      }
    },
    "tailwind": { "type": "object" },
    "metadata": { "type": "object" }
  }
}
